# 宿主机参考：NVIDIA Driver 580+（nvidia-smi 显示 CUDA 13.0 为驱动支持上限）、Tesla V100 等
# 构建（仓库根目录）：docker build -f discoverse/docker/Dockerfile.vnc -t discoverse:vnc .
# 运行示例：
#   docker run -dit --name discoverse-vnc --gpus all \
#     -p 6901:6901 -p 5901:5901 \
#     discoverse:vnc
# 浏览器访问 noVNC：http://<服务器IP>:6901/   （VNC 直连端口 5901 按需映射）

FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV NVIDIA_VISIBLE_DEVICES=all
ENV PYTHON_VERSION=3.10
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y \
    git \
    curl \
    software-properties-common \
    libgl1-mesa-dev \
    libglew-dev \
    libegl1-mesa-dev \
    libgles2-mesa-dev \
    libnvidia-egl-wayland1 \
    libosmesa6-dev \
    xvfb \
    libx11-6 \
    libxext6 \
    libglfw3-dev \
    libglu1-mesa-dev \
    libglm-dev \
    pkg-config \
    --no-install-recommends && \
    apt-get clean

# Install Python 3.10
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-dev \
    python3.10-distutils \
    python3.10-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade setuptools pip build

COPY . /root/DISCOVERSE

# Install base dependencies
RUN python3 -m pip install --no-cache-dir \
    scipy \
    mediapy \
    opencv-python \
    mujoco -i https://pypi.tuna.tsinghua.edu.cn/simple

RUN python3 -m pip install --no-cache-dir torch>=2.0.0 --index-url https://download.pytorch.org/whl/cu118

# Install 3DGS related dependencies
RUN python3 -m pip install --no-cache-dir \
    gaussian_renderer -i https://pypi.tuna.tsinghua.edu.cn/simple

WORKDIR /root/DISCOVERSE
RUN python3 -m pip install -e .

# Fix Rendering Issue
ENV MUJOCO_GL=glfw
RUN mkdir -p /usr/share/glvnd/egl_vendor.d/ && \
   echo '{\n    "file_format_version" : "1.0.0",\n    "ICD" : {\n        "library_path" : "libEGL_nvidia.so.0"\n    }\n}' > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

# VNC：x11vnc + noVNC（xvfb 已在上方安装，此处不再重复）
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    x11vnc \
    fluxbox \
    net-tools \
    novnc \
    websockify \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV DISPLAY=:1 \
    VNC_PORT=5901 \
    NO_VNC_PORT=6901 \
    VNC_COL_DEPTH=24 \
    VNC_RESOLUTION=1920x1080

RUN cp /usr/share/novnc/vnc_lite.html /usr/share/novnc/index.html && \
    chmod +x /root/DISCOVERSE/discoverse/docker/start-vnc.sh

# 使用具体端口，避免部分 Docker 版本无法展开 EXPOSE 变量
EXPOSE 5901 6901

CMD ["/bin/bash", "/root/DISCOVERSE/discoverse/docker/start-vnc.sh"]
